# SOLICITAR AO GESTOR DO SISTEMA QUE INSIRA : 
#1) NOME DO ALUNO 2
#) INSERIR A PRIMEIRA NOTA 
#3) INSERIR A SEGUNDA NOTA 
#4) INSERIR A TERCEIRA NOTA, EXEMPLO:

NOME = INPUT("DIGITE O NOME DO ALUNO:")
NOTA1 =FLOAT(INPUT("DIGITE A PRIMEIRA NOTA:"))
NOTA2 =FLOAT(INPUT("DIGITE A SEGUNDA NOTA:"))
NOTA3 =FLOAT(INPUT("DIGITE A TERCEIRA NOTA:"))

# CALCULE A MEDIA BASEADO NA ENTRADA DE NOTAS, EXEMPLO:

MEDIA = (NOTA1+NOTA2+NOTA3)/3

#ENTÃO COM O RESULTADO DA MEDIA ,BASEADO NO CRITERIO DE CORTE DE NOTA 
#SE MEDIA >= 7 ,APRESENTA (SITUAÇÃO APROVADO) 
#SE MEDIA >=5 AND MEDIA <7 ,APRESENTA (SITUAÇÃO RECUPERAÇÃO)
#SENÃO ,APRESENTA (SITUAÇÃO REPROVADO) EXEMPLO:

IF MEDIA >=7:
SITUACAO ="APROVADO"
ELIF MEDIA >=5 AND <7:
SITUACAO ="RECUPERAÇÃO"
ELSE:
SITUACAO ="REPROVADO"

PRINT("\NALUNO:",NOME)
PRINT("MÉDIA:",MEDIA)
PRINT("SITUAÇÃO:",SITUACAO)


